{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": [
    "python-full@3.13.5",
    "pipenv@2026.5.1",
  ],
  "shell": {
    "scripts": {
      "dev": [
        "echo 'To install packages run: pipenv install'",
        "echo 'To start the app run: fastapi dev'",
        "devbox run pipenv shell"
      ]
    }
  }
}
