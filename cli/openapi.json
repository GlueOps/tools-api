          }
        },
        "type": "object",
        "required": [
          "captain_domain"
        ],
        "title": "K3dLbNodesDeleteRequest"
      },
      "K3dLbNodesRequest": {
        "properties": {
          "captain_domain": {
            "type": "string",
            "title": "Captain Domain",
            "example": "nonprod.foobar.onglueops.rocks"
          },
          "node_count": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Node Count",
            "description": "Number of exit nodes to create (1-6, default: 3)",
            "default": 3,
            "example": 3
          }
        },
        "type": "object",
        "required": [
          "captain_domain"
        ],
        "title": "K3dLbNodesRequest"
      },
      "KubeApiserverManifestRequest": {
        "properties": {
          "captain_domain": {
            "type": "string",
            "title": "Captain Domain",
            "description": "Drives both the SNI host (kube-api.<captain_domain>) and the external-dns target (platform-v2.<captain_domain>).",
            "example": "nonprod.foobar.onglueops.rocks"
          },
          "allowed_source_ranges": {
            "type": "string",
            "title": "Allowed Source Ranges",
            "description": "Comma-separated CIDR ranges allowed to reach the kube-apiserver; at least one required. Replace the example (RFC 5737 documentation ranges) with your own IPs.",
            "example": "192.0.2.10/32,198.51.100.0/24"
          }
        },
        "type": "object",
        "required": [
          "captain_domain",
          "allowed_source_ranges"
        ],
        "title": "KubeApiserverManifestRequest"
      },
      "KubeRbacManifestRequest": {
        "properties": {
          "captain_domain": {
            "type": "string",
            "title": "Captain Domain",
