  "components": {
    "schemas": {
      "AwsCredentialsRequest": {
        "properties": {
          "aws_sub_account_name": {
            "type": "string",
            "title": "Aws Sub Account Name",
            "example": "glueops-captain-foobar"
          }
        },
        "type": "object",
        "required": [
          "aws_sub_account_name"
        ],
        "title": "AwsCredentialsRequest"
      },
      "AwsNukeAccountRequest": {
