            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/k3d-lb-nodes": {
      "post": {
        "summary": "Recreate k3d-lb nodes on Proxmox (destructive)",
        "description": "Creates Chisel nodes on Proxmox (via Waggle placement) for dev/k3d clusters. This allows us to\nmimic a Cloud Controller for Loadbalancers (e.g. NLBs with EKS).\n\nIf you are testing within k3ds you will need chisel to provide you with load balancers.\nFor a provided captain_domain this will delete any existing k3d-lb nodes and provision new ones.\nPlacement is decided by Waggle (pool per captain_domain); the VMs are then created on the assigned\nProxmox hypervisors and their IPs are read back through the QEMU guest agent.\nNote: this will generally result in new IPs being provisioned.",
        "operationId": "create_k3d_lb_nodes_v1_k3d_lb_nodes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/K3dLbNodesRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete k3d-lb nodes on Proxmox (destructive)",
        "description": "Deletes your k3d-lb nodes. Please run this when you are done with development to free up capacity.\n\nWhen you are done testing with k3ds this will delete your k3d-lb nodes (Proxmox VMs + Waggle pool) and free up capacity.",
        "operationId": "delete_k3d_lb_nodes_v1_k3d_lb_nodes_delete",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/K3dLbNodesDeleteRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/incidentio": {
      "post": {
        "summary": "Generate incident.io alerts manifest",
        "description": "Create an incident.io/alertmanager configuration. Do this for any clusters you want alerts on.",
        "operationId": "create_incidentioalerts_manifest_v1_incidentio_post",
        "requestBody": {
          "content": {
